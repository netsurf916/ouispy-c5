# T-Dongle C5 hardware configuration.
# LILYGO specifies 16 MB flash on this board; ESP-IDF otherwise defaults this
# project to 2 MB, which is too small for the custom 3 MB application partition.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Passive monitor tuning for ESP32-C5.
# Promiscuous callbacks run in the WiFi task and packet buffers are only valid
# for the duration of the callback. Extra RX buffers provide headroom during
# bursts while channel hopping and serial logging are active.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# BLE observation uses NimBLE for a small receive-only host footprint. WiFi and
# BLE share the ESP32-C5 2.4 GHz RF path, so software coexistence is enabled.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# The combined WiFi/BLE image is larger than the default 1 MB factory slot.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
